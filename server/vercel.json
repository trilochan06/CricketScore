{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/downloads/CricketScore.dmg",
      "destination": "https://github.com/trilochan06/CricketScore/releases/latest/download/CricketScore.dmg",
      "permanent": false
    },
    {
      "source": "/download",
      "destination": "https://github.com/trilochan06/CricketScore/releases/latest/download/CricketScore.dmg",
      "permanent": false
    }
  ]
}
